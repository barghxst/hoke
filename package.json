{
  "name": "hoke-workspace",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm build:wasm && pnpm --filter hoke build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "test": "vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "pnpm check:js && pnpm check:rust && pnpm test:bench",
    "format": "biome format --write .",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "demo": "node scripts/demo.mjs",
    "check:js": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:wasm && pnpm test:package && pnpm test:demo",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings && cargo test --workspace --locked",
    "format:rust": "cargo fmt --all",
    "bench": "python3 scripts/bench.py",
    "test:bench": "python3 -m unittest discover -s scripts -p test_bench.py",
    "test:browser": "pnpm build && playwright test",
    "check:all": "pnpm check && pnpm test:browser",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:wasm": "node scripts/test-wasm.mjs",
    "test:demo": "node --test scripts/demo/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.37.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "type": "module"
}
