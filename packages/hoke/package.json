{
  "name": "hoke",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "wasm"
  ],
  "sideEffects": false,
  "exports": {
    "./kv": {
      "react-native": {
        "types": "./dist/kv/native/index.d.ts",
        "import": "./dist/kv/native/index.js",
        "default": "./dist/kv/native/index.js"
      },
      "browser": {
        "types": "./dist/kv/web/index.d.ts",
        "import": "./dist/kv/web/index.js",
        "default": "./dist/kv/web/index.js"
      },
      "types": "./dist/kv/index.d.ts",
      "import": "./dist/kv/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "description": "Typed key-value storage with reactive, versioned stores for JavaScript and React.",
  "peerDependencies": {
    "react": ">=19.3.0 <20",
    "react-native-mmkv": ">=4.3.2 <5",
    "react-native-nitro-modules": ">=0.35.0 <1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native-mmkv": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    }
  }
}
